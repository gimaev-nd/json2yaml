# JSON → YAML: кириллица, скаляры, список, вложенный объект.
# Кириллица не должна уезжать в ; отступы — 2 пробела.
POST http://{{host}}/api/json-to-yaml
Content-Type: application/json
{
  "text": "{\"привет\": \"мир\", \"число\": 42, \"флаг\": true, \"пусто\": null, \"список\": [1, \"два\"], \"вложенный\": {\"а\": \"б\"}}"
}

HTTP 200
[Asserts]
header "Content-Type" contains "text/plain"
```
привет: мир
число: 42
флаг: true
пусто:
список:
- 1
- два
вложенный:
  а: б
```
